# Wait for server to be ready on 8443 (HTTPS) or 8080 (HTTP)
for i in $(seq 1 30); do
    if nc -z localhost 8443 2>/dev/null; then
        URL="https://localhost:8443"
        break
    elif nc -z localhost 8080 2>/dev/null; then
        URL="http://localhost:8080"
        break
    fi
    sleep 1
done

/usr/bin/chromium --kiosk --noerrdialogs --disable-infobars --no-first-run --ozone-platform=wayland --enable-features=OverlayScrollbar --start-maximized --ignore-certificate-errors "${URL}"
