#!/bin/bash
# Pi Weather Station — start-weather (without systemd)
# Starts the Node.js server, waits for it to be ready,
# then launches Chromium in kiosk mode.
# Works with labwc, wayfire, and X11/LXDE display servers.
#
# To allow access from the local network, uncomment the ALLOW_REMOTE line.

cd "$HOME/pi-weather-station"

# Load nvm if available — check common install locations
for _NVM_DIR in "$HOME/.nvm" "${XDG_CONFIG_HOME:-$HOME/.config}/nvm" "$HOME/.config/nvm"; do
    if [ -s "$_NVM_DIR/nvm.sh" ]; then
        export NVM_DIR="$_NVM_DIR"
        \. "$NVM_DIR/nvm.sh"
        break
    fi
done

# Start the Node.js server
# ALLOW_REMOTE=true npm start >> /tmp/weather-server.log 2>&1 &
# ALLOW_REMOTE=true REMOTE_SECURITY=true npm start >> /tmp/weather-server.log 2>&1 &
# DEBUG=true npm start >> /tmp/weather-server.log 2>&1 &
npm start >> /tmp/weather-server.log 2>&1 &

# Wait for server on 8443 (HTTPS) or 8080 (HTTP)
for i in $(seq 1 30); do
    if (echo > /dev/tcp/localhost/8443) 2>/dev/null; then
        URL="https://localhost:8443"
        break
    elif (echo > /dev/tcp/localhost/8080) 2>/dev/null; then
        URL="http://localhost:8080"
        break
    fi
    sleep 1
done

# Detect Chromium binary (name varies by OS version)
CHROMIUM=$(which chromium 2>/dev/null || which chromium-browser 2>/dev/null)

# Chromium flags based on display server
if [ -n "$WAYLAND_DISPLAY" ]; then
    FLAGS="--ozone-platform=wayland --enable-features=OverlayScrollbar --start-maximized"
fi

"$CHROMIUM" --kiosk --noerrdialogs --disable-infobars --no-first-run \
    --ignore-certificate-errors \
    --ignore-gpu-blocklist \
    --enable-gpu-rasterization \
    --enable-zero-copy \
    $FLAGS "$URL"
