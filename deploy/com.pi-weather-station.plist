<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<!--
  macOS launchd user agent for Pi Weather Station
  Equivalent of deploy/pi-weather-server.service (systemd) on Linux/Pi.

  Installation:
    1. Replace __INSTALL_DIR__ below (all three occurrences) with the absolute
       path to your install directory (e.g. /Users/yourname/pi-weather-station)
       — ~ is not supported by launchd.
    2. Copy to your LaunchAgents folder:
         cp deploy/com.pi-weather-station.plist ~/Library/LaunchAgents/
    3. Load the agent (macOS 10.10+):
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.pi-weather-station.plist
    4. The server will now start automatically at login.

  Useful commands (macOS 10.10+):
    Load:    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.pi-weather-station.plist
    Unload:  launchctl bootout  gui/$(id -u) ~/Library/LaunchAgents/com.pi-weather-station.plist
    Start:   launchctl start  com.pi-weather-station
    Stop:    launchctl stop   com.pi-weather-station
    Restart: launchctl stop   com.pi-weather-station && launchctl start com.pi-weather-station
    Status:  launchctl list | grep pi-weather
    Logs:    tail -f your-install-dir/server.log

  Note: launchctl load/unload still work on most systems but are deprecated since macOS 10.10.
        Use bootstrap/bootout to avoid "Load failed: Input/output error".

  Optional environment variables (uncomment as needed):
    ALLOW_REMOTE=true   — allow access from other devices on the local network
    DEBUG=true          — enable the debug panel
-->

<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pi-weather-station</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>npm start</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__INSTALL_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>NODE_ENV</key>
        <string>production</string>
        <!-- <key>ALLOW_REMOTE</key> <string>true</string> -->
        <!-- <key>DEBUG</key>        <string>true</string> -->
    </dict>

    <!-- Start automatically at login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart automatically if the server crashes -->
    <key>KeepAlive</key>
    <true/>

    <!-- Log output — same file used by the server -->
    <key>StandardOutPath</key>
    <string>__INSTALL_DIR__/server.log</string>
    <key>StandardErrorPath</key>
    <string>__INSTALL_DIR__/server.log</string>
</dict>
</plist>
