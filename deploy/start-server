#!/bin/bash
# Pi Weather Station — start-server
# Waits for the server to be ready, then launches Chromium in kiosk mode.
# Works with labwc, wayfire, and X11/LXDE display servers.

# Wait for server on 8443 (HTTPS) or 8080 (HTTP)
for i in $(seq 1 30); do
    if (echo > /dev/tcp/localhost/8443) 2>/dev/null; then
        URL="https://localhost:8443"
        break
    elif (echo > /dev/tcp/localhost/8080) 2>/dev/null; then
        URL="http://localhost:8080"
        break
    fi
    sleep 1
done

# Detect Chromium binary (name varies by OS version)
CHROMIUM=$(which chromium 2>/dev/null || which chromium-browser 2>/dev/null)

# Chromium flags based on display server
if [ -n "$WAYLAND_DISPLAY" ]; then
    FLAGS="--ozone-platform=wayland --enable-features=OverlayScrollbar --start-maximized"
fi

"$CHROMIUM" --kiosk --noerrdialogs --disable-infobars --no-first-run \
    --ignore-certificate-errors --touch-events=enabled \
    --remote-debugging-port=9222 $FLAGS "$URL"
