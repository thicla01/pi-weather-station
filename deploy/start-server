#!/bin/bash
# Pi Weather Station — start-server
# Waits for the server to be ready, then launches the configured browser
# in kiosk mode. Browser choice is persisted by install.sh in
# ~/.config/pi-weather-station/browser.conf (BROWSER_CMD + BROWSER_FAMILY).
# Falls back to auto-detecting Chromium when no config is present, for
# backward compatibility with older installations.

# --- 1. Wait for the local pi-weather-server (HTTPS preferred) -----------
# Cold boots after a power outage need more patience than a clean `sudo
# reboot`: the router/switch reboot in parallel with the Pi, so the
# server's ExecStartPre DNS wait can spend its full 60 s before `npm
# start` even launches. A 30 s window expires while the service is still
# in ExecStartPre, leaving the kiosk dark with no retry (XDG autostart
# fires once per session). 5 min covers any reasonable cold-boot
# recovery; progress is logged every 30 s for diagnosis.
URL=""
SERVER_WAIT_TIMEOUT=300
for i in $(seq 1 $SERVER_WAIT_TIMEOUT); do
    if (echo > /dev/tcp/localhost/8443) 2>/dev/null; then
        URL="https://localhost:8443"
        break
    elif (echo > /dev/tcp/localhost/8080) 2>/dev/null; then
        URL="http://localhost:8080"
        break
    fi
    if [ $((i % 30)) -eq 0 ]; then
        echo "start-server: still waiting for pi-weather-server (${i}/${SERVER_WAIT_TIMEOUT}s)..." >&2
    fi
    sleep 1
done

if [ -z "$URL" ]; then
    echo "start-server: pi-weather-server not reachable after ${SERVER_WAIT_TIMEOUT}s — aborting." >&2
    exit 1
fi

# --- 2. Resolve the browser command + family ------------------------------
CONFIG_FILE="$HOME/.config/pi-weather-station/browser.conf"
BROWSER_CMD=""
BROWSER_FAMILY=""

if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
fi

# Fallback: auto-detect a browser when no config exists. Keeps existing
# installs working until they re-run install.sh.
if [ -z "$BROWSER_CMD" ]; then
    BROWSER_CMD=$(command -v chromium 2>/dev/null \
        || command -v chromium-browser 2>/dev/null \
        || command -v google-chrome 2>/dev/null \
        || command -v firefox 2>/dev/null \
        || true)
fi

if [ -z "$BROWSER_FAMILY" ]; then
    case "$(basename "$BROWSER_CMD")" in
        chromium|chromium-browser|google-chrome|google-chrome-stable|microsoft-edge|microsoft-edge-stable|brave-browser)
            BROWSER_FAMILY="chromium" ;;
        firefox|firefox-esr)
            BROWSER_FAMILY="firefox" ;;
    esac
fi

if [ -z "$BROWSER_CMD" ] || ! command -v "$BROWSER_CMD" >/dev/null 2>&1; then
    echo "start-server: no usable browser found. Re-run install.sh to configure one." >&2
    exit 1
fi

# --- 2.5. Defensive: clear stale Chromium singleton locks from hostname changes ---
# Chromium encodes the holding process's hostname in the SingletonLock
# symlink target (`HOSTNAME-PID`). On launch it checks the embedded
# hostname against the current one — a legacy safeguard for shared-NFS
# setups. If they don't match, Chromium refuses with "profile in use by
# another computer" and exits silently (no GUI error in kiosk mode), so
# a `sudo raspi-config` hostname change can break the kiosk with no
# visible cause until the user opens a terminal and runs the launcher
# manually. Only clear the lock when the embedded hostname differs from
# the current one — a Chromium genuinely running on the same host keeps
# its lock untouched.
clean_orphan_chromium_lock() {
    profile_dir="$1"
    lock="$profile_dir/SingletonLock"
    [ -L "$lock" ] || return 0
    target=$(readlink "$lock" 2>/dev/null) || return 0
    lock_host="${target%-*}"
    if [ -n "$lock_host" ] && [ "$lock_host" != "$(hostname)" ]; then
        echo "start-server: clearing stale Chromium lock from hostname '$lock_host' (now '$(hostname)')" >&2
        rm -f "$lock" "$profile_dir/SingletonCookie" "$profile_dir/SingletonSocket"
    fi
}

if [ "$BROWSER_FAMILY" = "chromium" ]; then
    case "$(basename "$BROWSER_CMD")" in
        chromium|chromium-browser)              clean_orphan_chromium_lock "$HOME/.config/chromium" ;;
        google-chrome|google-chrome-stable)     clean_orphan_chromium_lock "$HOME/.config/google-chrome" ;;
        microsoft-edge|microsoft-edge-stable)   clean_orphan_chromium_lock "$HOME/.config/microsoft-edge" ;;
        brave-browser)                          clean_orphan_chromium_lock "$HOME/.config/BraveSoftware/Brave-Browser" ;;
    esac
fi

# --- 3. Launch in kiosk mode with family-specific flags ------------------
case "$BROWSER_FAMILY" in
    chromium)
        FLAGS=""
        if [ -n "$WAYLAND_DISPLAY" ]; then
            FLAGS="--ozone-platform=wayland --enable-features=OverlayScrollbar --start-maximized"
        fi
        # Chrome DevTools remote-debugging port (localhost:9222). OFF by
        # default: while open, ANY local process can attach and drive the
        # kiosk session — reaching the server's localhost-gated endpoints
        # (settings writes, debug panel). Enable only for diagnostics by
        # setting KIOSK_REMOTE_DEBUG=true (export it, or add it to
        # browser.conf, which this script sources). See the drag-scroll /
        # V3D-freeze incident notes for when it's useful.
        if [ "${KIOSK_REMOTE_DEBUG:-}" = "true" ]; then
            FLAGS="$FLAGS --remote-debugging-port=9222"
        fi
        # shellcheck disable=SC2086
        "$BROWSER_CMD" --kiosk --noerrdialogs --disable-infobars --no-first-run \
            --ignore-certificate-errors --touch-events=enabled \
            $FLAGS "$URL"
        ;;
    firefox)
        # Firefox has no CLI flag to bypass SSL warnings — the user accepts
        # the self-signed cert once on first launch, a dedicated named profile
        # remembers it, and subsequent launches are silent.
        #
        # Use a NAMED profile (-P) rather than a custom --profile <path>:
        # Firefox-as-snap (the default packaging on Ubuntu 25+) is confined
        # and refuses to access arbitrary paths under ~/.config, so the
        # path-based form fails silently with snap. The named profile lives
        # wherever Firefox decides to put it, which is always inside the
        # confinement on snap and inside ~/.mozilla/firefox/ on deb installs
        # — both work without intervention.
        PROFILE_NAME="pi-weather-station"
        "$BROWSER_CMD" -CreateProfile "$PROFILE_NAME" >/dev/null 2>&1 || true
        # --no-remote ensures we don't reuse a non-kiosk Firefox window if one
        # is already open with another profile.
        "$BROWSER_CMD" --kiosk --no-remote -P "$PROFILE_NAME" "$URL"
        ;;
    *)
        echo "start-server: unknown browser family '$BROWSER_FAMILY'. Re-run install.sh." >&2
        exit 1
        ;;
esac
