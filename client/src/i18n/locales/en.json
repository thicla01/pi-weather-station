      "displayGroup": "Display",
      "lightModeStyle": "Light-mode map style",
      "lightModeStyleHint": "v10 / v11 are the classic pale Mapbox light styles (panel turns near-white). Streets is the warmer green/beige variant with stronger labels (panel turns cream).",
      "darkModeStyle": "Dark-mode map style",
      "darkModeStyleHint": "v10 is the classic dark Mapbox style. v11 is the modern variant — slightly different palette and label rendering. Both keep the same dark grey panel.",
      "radarOpacityLight": "Radar opacity (light mode)",
      "radarOpacityLightHint": "How strongly the radar overlay tints the basemap when light mode is active. 70% is the historical default — lower values let the basemap show through, higher values make rain bands stand out.",
      "radarOpacityDark": "Radar opacity (dark mode)",
      "radarOpacityDarkHint": "Same control but for dark mode. The default is lower (30%) because the dark basemap makes radar colours pop naturally — too high and they look saturated.",
      "brightness": "Display brightness",
      "brightnessHint": "Hardware-level dimming of the connected screen. Floors at 10% to keep the display readable. Hidden on devices that don't expose a backlight (HDMI monitors, no kernel overlay, etc.).",
      "aiGroup": "AI weather summary",
      "radarAnalysisEnabled": "Radar analysis",
      "radarAnalysisEnabledHint": "Generates the third \"Radar analysis\" paragraph in the AI summary and shows the sampling-zone circles on the map (50 km / 100 km dashed). Turn off to reduce Anthropic token usage. The rain-alert banner uses the same risk data computed locally and is unaffected.",
      "extendedRadius": "Extended radius",
      "extendedRadiusHint": "Roughly doubles the sampling radius (50 → 100 km, or 30 → 60 mi depending on the distance unit). Adds the outer ring (32 directions × 10 distances) for longer-range storm tracking.",
      "showSamplingPoints": "Show sampling points on map",
      "showSamplingPointsHint": "Displays a small dot at every position the AI summary samples on the radar.",
      "calmDayFastPath": "Calm-day fast path",
      "calmDayFastPathHint": "When current conditions are clearly benign (no precipitation now, low chance ahead), skip the Claude call and emit a templated summary instead. Saves Anthropic tokens on quiet days with no quality loss — Claude is still called whenever something interesting is happening. Turn off if you'd rather always get the natural-language version.",
      "sleepGroup": "Sleep mode",
      "sleepEnabled": "Enable sleep mode",
      "sleepEnabledHint": "After a period of inactivity, fades to a minimal full-screen clock at reduced brightness. Touch or move the cursor to wake.",
      "sleepStage1Delay": "Inactivity before sleep",
      "sleepStage1DelayHint": "How long with no touch / mouse / keyboard input before the screensaver fades in.",
      "sleepStage1Brightness": "Sleep brightness",
      "sleepStage1BrightnessHint": "Hardware brightness applied while the screensaver is showing the clock. Hidden on devices without a backlight.",
      "sleepStage2Enabled": "Black-screen stage",
      "sleepStage2EnabledHint": "After a further delay, switch to a black screen with a tiny moving dot to prevent LCD burn-in. Brightness drops to its floor.",
      "sleepStage2Delay": "Black-screen delay",
      "sleepStage2DelayHint": "Time after the screensaver appears before switching to the black-screen stage. The backlight is dropped fully off (where the panel allows it).",
      "sleepNightMode": "Red text at night",
      "sleepNightModeHint": "When dark mode is active, use red-tinted text instead of cream. Long-wavelength red light has minimal impact on melatonin — friendlier in a bedroom or hallway visible at night.",
      "sleepMinutes": "{{count}} min",
      "previewGroup": "Interface",
      "ambientPreview": "Ambient interface v3",
      "ambientPreviewHint": "v3 is the default interface since v2.18 — a full rebuild of the dashboard, settings, and debug panels with refreshed visuals and phone-friendly layouts. Disable this to temporarily fall back to the legacy v2 interface if you hit an issue, and please report it at github.com/thicla01/pi-weather-station/issues so we can fix it before the v2 code path is removed in a future release."
    }
